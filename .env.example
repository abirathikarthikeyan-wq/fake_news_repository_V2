# Create a Supabase project and copy its Project URL + service_role key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Generate a long random secret (at least 32 characters). Keep it private.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Google Fact Check Tools API key (optional but recommended).
# Enable "Fact Check Tools API" in Google Cloud Console.
GOOGLE_FACTCHECK_API_KEY=your-google-fact-check-api-key
# Optional: Brave Search API adds related web sources (not a truth verdict).
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
